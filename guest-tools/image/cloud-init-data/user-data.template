#cloud-config

users:
  - name: abadmin
    groups: sudo
    shell: /bin/bash
    sudo: ['ALL=(ALL) NOPASSWD:ALL']

write_files:
- content: |
    network:
        version: 2
        renderer: networkd
        ethernets:
            en:
                match:
                    name: "en*"
                dhcp4: true
                dhcp-identifier: mac
  path: /etc/netplan/netplan.yaml
- content: |
    ===========================================================================
    Welcome to Ubuntu noble (24.04)
    Created by Kobuk team
    ===========================================================================
  path: /etc/motd
- content: |
    SUBSYSTEM=="misc",KERNEL=="tdx-guest",MODE="0666"
  path: /etc/udev/rules.d/90-tdx.rules

packages:
  - python3-pip=23.0.1+dfsg-1ubuntu0.1
  - golang-go=2:1.21.3-1ubuntu1
  - golang=2:1.21~3ubuntu1
  - golang-doc=2:1.21~3ubuntu1
  - ntp=1:4.2.8p15+dfsg-1ubuntu2
  - postgresql-16=16.1-1.pgdg24.04+1
  - google-compute-engine=20240607.00-0ubuntu1~24.04.0

runcmd:
  - systemctl enable google-guest-agent
  - systemctl start google-guest-agent
  - sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication no/' /etc/ssh/sshd_config
  - sed -i 's/^#\?ChallengeResponseAuthentication.*/ChallengeResponseAuthentication no/' /etc/ssh/sshd_config
  - sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin no/' /etc/ssh/sshd_config
  - systemctl restart sshd
  - systemctl enable postgresql
  - systemctl start postgresql

power_state:
  delay: now
  mode: poweroff
  message: Bye Bye
  timeout: 1
  condition: True
